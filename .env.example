# ==============================================================================
# Sanity CMS & Next.js Environment Variables
# ==============================================================================

# Public CMS Identifiers (Safe for client-side bundle)
NEXT_PUBLIC_SANITY_PROJECT_ID="pi13i3as"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-03-01"

# Explicit Development Mock Data Flag (Keep false for live CMS)
NEXT_PUBLIC_USE_MOCK_DATA="false"

# ------------------------------------------------------------------------------
# Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_, never commit to git)
# ------------------------------------------------------------------------------

# 1. Sanity API Read Token
# Role: Viewer (read-only) or Editor
# Needed for: Fetching unpublished drafts in Draft Mode previews
# Generate at: https://manage.sanity.io/ -> Project -> API -> Tokens -> Add API token
SANITY_API_READ_TOKEN="your-sanity-api-read-token-here"

# 2. Sanity Webhook Revalidation Secret
# Needed for: HMAC-SHA256 signature verification in /api/revalidate
# Generate at: https://manage.sanity.io/ -> Project -> API -> Webhooks -> Add Webhook
#
# Webhook Configuration in Sanity Manage:
# - URL: https://your-domain.vercel.app/api/revalidate
# - Dataset: production
# - Trigger on: Create, Update, Delete
# - Filter: _type in ["photograph", "collection", "siteSettings"]
# - HTTP Method: POST
# - Secret: Must match SANITY_REVALIDATE_SECRET
# - Projection (Uses coalesce to correctly handle create, update, delete, and unpublish events):
#   {
#     "operation": delta::operation(),
#     "_id": coalesce(_id, before()._id),
#     "_type": coalesce(_type, before()._type),
#     "slug": coalesce(slug.current, before().slug.current),
#     "previousSlug": before().slug.current,
#     "collectionSlug": coalesce(collection->slug.current, before().collection->slug.current),
#     "previousCollectionSlug": before().collection->slug.current,
#     "featured": coalesce(featured, before().featured),
#     "isHero": coalesce(isHero, before().isHero)
#   }
SANITY_REVALIDATE_SECRET="your-sanity-webhook-secret-here"

# 3. Direct Draft Preview Secret
# Optional fallback for authenticating direct preview links (?secret=...&slug=...)
# Note: For production editing, Sanity Presentation Tool (@sanity/preview-url-secret)
# is preferred as it uses single-use, ephemeral signed tokens.
SANITY_PREVIEW_SECRET="your-custom-preview-secret-here"
